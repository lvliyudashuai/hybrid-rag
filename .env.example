# 复制成 .env 后按需修改：cp .env.example .env
# 每一项都有合理默认值，全部注释掉也能跑（会用内置默认）。

# ---------- 文档来源 ----------
# 单个文档（也支持 pdf / txt / md / html / csv / xlsx / json）
#DOC_PATH=./rag.docx
# 文档类型，留空按扩展名自动判断：docx / pdf
#DOC_TYPE=
# 批量来源：逗号分隔的文件或目录（目录会递归扫描），优先级高于 DOC_PATH
#SOURCES=./docs,./contracts

# ---------- 向量库 ----------
#CHROMA_DIR=./chroma_db
#COLLECTION_NAME=rag_kb

# ---------- 分块 ----------
#CHUNK_SIZE=500
#CHUNK_OVERLAP=50
#MIN_CHUNK_CHARS=20
# 把章节路径拼在块前再向量化，长文档召回明显更好
#CHUNK_CONTEXT_PREFIX=1

# ---------- 向量模型 ----------
# 中文推荐 Qwen/Qwen3-Embedding-0.6B（约 1.2GB）；轻量可选 BAAI/bge-small-zh-v1.5
#EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# auto 会优先用显卡，也可以写 cpu / cuda / cuda:0
#EMBEDDING_DEVICE=auto
# 只用本地缓存（不联网），首次下载模型时设为 0
#EMBEDDING_LOCAL_ONLY=0
#EMBEDDING_BATCH_SIZE=32
#EMBEDDING_MAX_LENGTH=512
# 只加在查询侧的前缀；Qwen3-Embedding 官方 instruct 写法示例：
#EMBEDDING_QUERY_PREFIX=Instruct: 给定用户问题，检索能回答该问题的文档段落\nQuery: 
# 国内直连 HuggingFace 慢时用镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 检索 ----------
# vector / keyword / hybrid
#RETRIEVAL_MODE=hybrid
#TOP_K=5
# 融合前每路各取多少候选
#CANDIDATE_K=20
# RRF 平滑常数，业界常用 60
#RRF_K=60
# 向量路权重，0.9 = 主要靠语义；文档里精确词多时应调低
#HYBRID_ALPHA=0.9
# MMR 去重开关与强度（1.0 = 关闭去重）
#USE_MMR=0
#MMR_LAMBDA=0.7
# 相似度低于该值直接丢弃（0 表示不过滤）
#SCORE_THRESHOLD=0
# CrossEncoder 重排：效果最好，但要多下一个模型
#USE_RERANK=0
#RERANK_MODEL=BAAI/bge-reranker-base
#RERANK_TOP_K=20

# ---------- 生成端 ----------
# deepseek / openai / claude / ollama / mock（mock = 离线模拟，不调用模型）
#LLM_PROVIDER=deepseek
#LLM_MODEL=deepseek-chat
#LLM_BASE_URL=https://api.deepseek.com
#LLM_TEMPERATURE=0.2
#LLM_MAX_TOKENS=1024
#LLM_TIMEOUT=60
#LLM_STREAM=1
# 拼给模型的参考资料字符上限
#MAX_CONTEXT_CHARS=6000

# ---------- API Key（只填你要用的那一个）----------
# 不填 = 自动退化成离线模拟，界面和命令行都能跑
DEEPSEEK_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#OLLAMA_API_KEY=

# ---------- 运维 ----------
#LOG_LEVEL=INFO
#LOG_FILE=
# 打印检索链路耗时
#TRACE=0
# 界面里上传的文件存这里
#UPLOAD_DIR=./uploads

# ---------- REST API（api.py）----------
#API_HOST=127.0.0.1
#API_PORT=8000
# 设了之后所有 /v1 接口都要带 X-API-Key
#API_TOKEN=
