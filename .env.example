# ---------- 文档 ----------
# DOC_PATH: 要入库的文档；DOC_TYPE: docx / pdf，留空按扩展名自动判断
# DOC_PATH=./rag.docx
# DOC_TYPE=

# ---------- 向量模型 ----------
# 中文推荐 Qwen/Qwen3-Embedding-0.6B；更轻量可选 BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 本地已有模型缓存时置 1，避免联网挂起 / 加速加载
# EMBEDDING_LOCAL_ONLY=0
# 无法直连 HuggingFace 时使用镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 分块 ----------
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5

# ---------- 生成端 ----------
# 可选：deepseek / openai / claude / mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 如果使用 OpenAI，可改：
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# 如果使用 Claude：
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=
